# Modelo de configuração pessoal. NÃO edite este arquivo com dados reais.
# Copie para ~/.config/ubuntu-setup/local.env (fora do repositório) e preencha lá:
#
#   mkdir -p ~/.config/ubuntu-setup && cp config/local.env.example ~/.config/ubuntu-setup/local.env

# Identidade do Git (modules/22-git.sh); o e-mail também vira o comentário da chave SSH
GIT_USER_NAME="Seu Nome"
GIT_USER_EMAIL="voce@example.com"
