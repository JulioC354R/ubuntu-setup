# ~/.zshrc — gerenciado pelo ubuntu-setup (config/zsh/zshrc).
# Ao rodar o setup, este arquivo é reinstalado (com backup se você o alterou).
# Personalizações da máquina: ~/.zshrc.local (não versionado).

# PATH e inicializações compartilhadas com o bash (~/.local/bin, Go, nvm, Bun, Rust...)
for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/ubuntu-setup/shell.d/*.sh(N); do source "$f"; done; unset f
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# Oh My Zsh: só plugins. Quem desenha o prompt é o Oh My Posh (no final).
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
# Ordem importa: fzf-tab depois dos plugins de completion e ANTES de zsh-autosuggestions e
# zsh-syntax-highlighting (que embrulham widgets e precisam ser os últimos).
plugins=(
  git                       # gst, gco, gcb, gp, glog...
  kubectl                   # k, kgp, kl, kaf... + completion
  docker docker-compose     # aliases + completion
  terraform                 # tf, tfp, tfa...
  azure aws                 # completion do az/aws, troca de perfil (asp, acp...)
  sudo                      # Esc Esc: põe sudo no começo do último comando
  extract                   # extract arquivo.tar.gz (qualquer formato)
  copypath copyfile         # copia caminho atual / conteúdo de arquivo (usa wl-clipboard)
  z                         # z api -> pula para pastas usadas com frequência
  web-search                # google termo -> abre a busca no navegador
  fzf-tab
  zsh-autosuggestions
  zsh-syntax-highlighting
)
source "$ZSH/oh-my-zsh.sh"

# Desliga o menu nativo do zsh para o fzf-tab cuidar de todas as completions (recomendação do fzf-tab)
zstyle ':completion:*' menu no

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/if_tea.omp.json)"
